{
  "name": "trading-engine",
  "version": "1.0.0",
  "private": true,
  "description": "Trading Engine: neural-network market intelligence. Next.js frontend + FastAPI (NumPy deep learning) backend.",
  "scripts": {
    "dev": "concurrently -k -n web,api -c gray,white \"next dev\" \"npm run api\"",
    "web": "next dev",
    "api": ".venv\\Scripts\\python -m uvicorn backend.app:app --reload --port 8000",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:py": ".venv\\Scripts\\python -m pytest -q"
  },
  "dependencies": {
    "lightweight-charts": "5.2.1",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^22.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "^9.1.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.9"
  }
}
