# Copy to .env for local development. On Vercel, set these in Project Settings > Environment Variables.

# Shared LLM key used for visitors who have not added their own (rate limited per visitor).
DEFAULT_LLM_PROVIDER=groq          # groq | gemini | anthropic
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional additional providers
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Shared-key budgets (per server instance)
LLM_SHARED_PER_MINUTE=5
LLM_SHARED_PER_DAY=600
LLM_SHARED_PER_IP_10MIN=8
TRAIN_PER_IP_10MIN=20

ENVIRONMENT=development
