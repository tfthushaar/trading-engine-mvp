# ══════════════════════════════════════════════════════════════════
# Trading Engine MVP — Environment Variables
# Copy this to .env and fill in your values.
# NEVER commit .env to git.
# ══════════════════════════════════════════════════════════════════

# ── App ───────────────────────────────────────────────────────────
APP_ENV=development                  # development | production
APP_SECRET_KEY=change-me-to-random-64-char-string
DEBUG=true

# ── Database ──────────────────────────────────────────────────────
POSTGRES_USER=trading
POSTGRES_PASSWORD=trading_secret
POSTGRES_DB=trading_mvp
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://trading:trading_secret@localhost:5432/trading_mvp

# DuckDB (analytics sidecar — keep for existing pipeline)
DUCKDB_PATH=./trading_data.duckdb

# ── Redis ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Vector DB ─────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001

# ── AI / LLM ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...          # Claude (primary LLM)
OPENAI_API_KEY=sk-...                 # GPT-4o (fallback + embeddings)

# ── Market Data APIs ──────────────────────────────────────────────
NEWS_API_KEY=...                      # newsapi.org
FRED_API_KEY=...                      # fred.stlouisfed.org
POLYGON_API_KEY=...                   # polygon.io (live prices + WS)
TRADIER_API_KEY=...                   # tradier.com (options chain)
FMP_API_KEY=...                       # financialmodelingprep.com (earnings)
UNUSUAL_WHALES_API_KEY=...            # unusualwhales.com (options flow)

# ── Social Data ───────────────────────────────────────────────────
REDDIT_CLIENT_ID=...
REDDIT_CLIENT_SECRET=...
REDDIT_USER_AGENT=trading-engine-mvp/1.0
STOCKTWITS_API_KEY=...               # optional

# ── Auth ─────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-another-random-64-char-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ─────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ── Monitoring ────────────────────────────────────────────────────
SENTRY_DSN=                          # leave blank to disable Sentry

# ── Scheduler ────────────────────────────────────────────────────
SCHEDULER_TIMEZONE=Asia/Kolkata      # IST for Indian markets
